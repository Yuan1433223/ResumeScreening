# 本项目默认无需任何 API 密钥（规则版 + Mock 抽取器/日历/通知，纯本地运行）。
# 以下变量为可选路径覆盖，缺省时使用 src/config.py 默认值。

# 业务 SQLite 路径（默认 data/resume.db）
# RESUME_DB_PATH=data/resume.db

# LangGraph 检查点 SQLite 路径（默认 data/resume.checkpoints.db）
# RESUME_CHECKPOINT_PATH=data/resume.checkpoints.db

# ---------------------------------------------------------------------------
# 云端大模型（T3）：在本地 .env 中补充以下字段后启用模型抽取（不入版本控制）。
# 未配置时 MODEL_ENABLED=0，模型抽取自动转人工复核，不影响规则版演示。
# 填写方式：复制本文件为 .env，填入 MODEL_API_KEY / MODEL_BASE_URL / MODEL_NAME。
# 协议约定：OpenAI 兼容 /chat/completions（OpenAI、DeepSeek、Moonshot 及多数
# provider 均兼容；若你的 provider 协议不同，改 model_extractor.CloudModelClient）。
# ---------------------------------------------------------------------------
MODEL_ENABLED=0
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# 单份简历预算上限（美分）；0 表示不限制。超限自动转人工复核。
MODEL_MAX_COST_CENTS=0
MODEL_PROMPT_VERSION=p1
MODEL_TEMPERATURE=0
# 计费价目（美分/千 token），可选；填了才会估算单份成本。
MODEL_COST_PER_1K_INPUT_CENTS=0
MODEL_COST_PER_1K_OUTPUT_CENTS=0

# ---------------------------------------------------------------------------
# 单用户认证（默认关闭）。开启后所有业务路由需登录 Cookie 才能访问。
# AUTH_ENABLED=1 时必须同时配置 AUTH_USERNAME / AUTH_PASSWORD，否则启动即报错。
# AUTH_SECRET_KEY 不填则由 AUTH_PASSWORD 确定性派生（生产应显式配置）。
# ---------------------------------------------------------------------------
AUTH_ENABLED=0
# AUTH_USERNAME=hr
# AUTH_PASSWORD=change-me
# AUTH_SECRET_KEY=please-generate-a-long-random-string
